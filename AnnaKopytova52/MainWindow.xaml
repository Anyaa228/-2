<Window x:Class="AnnaKopytova52.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор Копытовой Анны" Height="620" Width="400"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgDark}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HistoryTextBlock" Grid.Row="0" Height="26" FontSize="14"
                   Foreground="#C77DFF" HorizontalAlignment="Right" VerticalAlignment="Center" Text=""/>

        <Border Grid.Row="1" Margin="0,6,0,14" CornerRadius="14" Background="#2D1B4E" BorderBrush="{StaticResource AccentDark}" BorderThickness="1">
            <TextBox x:Name="DisplayBox" Height="72" FontSize="32" FontWeight="SemiBold"
                     Foreground="{StaticResource TextLight}" Background="Transparent" BorderThickness="0"
                     Padding="0,0,16,0" HorizontalContentAlignment="Right"
                     VerticalContentAlignment="Center" IsReadOnly="True" Text="0"/>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Row="0" Grid.Column="0" Content="Del" Click="Del_Click" Style="{StaticResource OpButton}"/>
            <Button Grid.Row="0" Grid.Column="1" Content="C" Click="Clear_Click" Style="{StaticResource OpButton}"/>
            <Button Grid.Row="0" Grid.Column="2" Content="(" Click="Button_Click" Style="{StaticResource OpButton}"/>
            <Button Grid.Row="0" Grid.Column="3" Content=")" Click="Button_Click" Style="{StaticResource OpButton}"/>

            <Button Grid.Row="1" Grid.Column="0" Content="7" Click="Button_Click"/>
            <Button Grid.Row="1" Grid.Column="1" Content="8" Click="Button_Click"/>
            <Button Grid.Row="1" Grid.Column="2" Content="9" Click="Button_Click"/>
            <Button Grid.Row="1" Grid.Column="3" Content="/" Click="Button_Click" Style="{StaticResource OpButton}"/>

            <Button Grid.Row="2" Grid.Column="0" Content="4" Click="Button_Click"/>
            <Button Grid.Row="2" Grid.Column="1" Content="5" Click="Button_Click"/>
            <Button Grid.Row="2" Grid.Column="2" Content="6" Click="Button_Click"/>
            <Button Grid.Row="2" Grid.Column="3" Content="*" Click="Button_Click" Style="{StaticResource OpButton}"/>

            <Button Grid.Row="3" Grid.Column="0" Content="1" Click="Button_Click"/>
            <Button Grid.Row="3" Grid.Column="1" Content="2" Click="Button_Click"/>
            <Button Grid.Row="3" Grid.Column="2" Content="3" Click="Button_Click"/>
            <Button Grid.Row="3" Grid.Column="3" Content="-" Click="Button_Click" Style="{StaticResource OpButton}"/>

            <Button Grid.Row="4" Grid.Column="0" Content="^" Click="Button_Click" Style="{StaticResource OpButton}"/>
            <Button Grid.Row="4" Grid.Column="1" Content="0" Click="Button_Click"/>
            <Button Grid.Row="4" Grid.Column="2" Content="." Click="Button_Click"/>
            <Button Grid.Row="4" Grid.Column="3" Content="+" Click="Button_Click" Style="{StaticResource OpButton}"/>

            <Button Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4" Content="=" Click="Equals_Click" FontSize="26" Background="{StaticResource Accent}"/>
        </Grid>
    </Grid>
</Window>